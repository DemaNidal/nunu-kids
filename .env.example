# انسخي هالملف لـ .env وعبّي القيم (ملف .env ما بينرفع على GitHub)
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/nunu_kids"

# حساب لوحة التحكم (بينعمل أول مرة مع npm run db:seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

PORT=5173

# النسخ الاحتياطي التلقائي: الساعة كم كل يوم (0-23). BACKUP_DISABLED=1 بيوقفه.
BACKUP_HOUR=3


R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=nunu-backups
R2_IMAGES_BUCKET=nunu-images
# الرابط العام لـ bucket الصور: هلأ رابط r2.dev المؤقت، وبعد شراء الدومين https://img.nunukids.com
R2_IMAGES_URL=
BACKUP_KEY=
