// تصميم قاعدة البيانات (PostgreSQL) — كل جدول وشو فيه
// بعد أي تعديل هون: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

// رابط قاعدة البيانات بملف prisma.config.mjs (من .env)
datasource db {
  provider = "postgresql"
}

// ===== المنتجات =====
model Product {
  id          Int          @id @default(autoincrement())
  name        String
  category    String       // underwear | clothes | accessories | bundles
  price       Int          // بالشيكل (أرقام صحيحة)
  description String       @default("")
  material    String?
  images      String[]     // روابط الصور بالترتيب (أول وحدة الرئيسية)
  colors      Json         @default("[]") // [{ name, hex }]
  isNew       Boolean      @default(false)
  visible     Boolean      @default(true)
  featured    Boolean      @default(false) // شارة "الأكثر طلباً" للبكجات
  sizes       ProductSize[]
  bundleItems BundleItem[] @relation("BundleContents") // إذا المنتج بكج: شو جواه
  inBundles   BundleItem[] @relation("BundlePiece")    // البكجات اللي فيها هالقطعة
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category, visible])
}

// الكمية بالمخزن من كل مقاس
model ProductSize {
  productId Int
  size      String  // 0-3 | 3-6 | 6-9 | 9-12 | one
  qty       Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, size])
}

// قطع البكج: قطعة من المتجر (productId) أو قطعة باسم بس (name)
model BundleItem {
  id        Int      @id @default(autoincrement())
  bundleId  Int
  productId Int?
  name      String?
  qty       Int      @default(1)
  position  Int      @default(0)
  bundle    Product  @relation("BundleContents", fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product? @relation("BundlePiece", fields: [productId], references: [id], onDelete: SetNull)

  @@index([bundleId])
}

// ===== العروض والكوبونات =====
model Offer {
  id         String    @id @default(cuid())
  active     Boolean   @default(true)
  label      String    @default("عرض خاص")
  title      String
  type       String    // percent | fixed | bxgy
  value      Int?      // للنسبة والمبلغ
  buy        Int?      // لـ "اشتري وخدي"
  get        Int?
  targetKind String    @default("all") // all | category | products
  targetIds  Json      @default("[]")
  banner     Boolean   @default(false)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  active    Boolean   @default(true)
  type      String    // percent | fixed | shipping
  value     Int       @default(0)
  minTotal  Int       @default(0)
  maxUses   Int?
  used      Int       @default(0)
  note      String    @default("")
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ===== الطلبات =====
model Order {
  id           Int           @id @default(autoincrement())
  number       String        @unique // NK-100001 (اللي بتشوفه الزبونة)
  status       String        @default("new") // new | confirmed | shipped | delivered | cancelled
  payment      String        @default("cod")
  // الزبونة (نسخة وقت الطلب)
  name         String
  phone        String        // دولي متل واتساب: 970599123456
  whatsappOk   Boolean       @default(true) // الزبونة بدها تأكيد الطلب على واتساب
  zone         String
  area         String        @default("") // القرية / المخيم / المنطقة
  city         String
  address      String
  notes        String        @default("")
  // المبالغ (نسخة وقت الطلب — ما بتتغير إذا تغيّرت الأسعار بعدين)
  subtotal     Int
  discounts    Json          @default("[]") // [{ title, amount }] من العروض
  couponCode   String?
  couponAmount Int           @default(0)
  shipping     Int
  total        Int
  adminNote    String        @default("")
  items        OrderItem[]
  history      OrderStatus[]
  access       OrderAccess[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int?    // ممكن ينحذف المنتج بعدين — الاسم والسعر محفوظين هون
  name      String
  size      String
  color     String  @default("")
  qty       Int
  unit      Int     // سعر القطعة وقت الطلب
  image     String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// مفاتيح تتبع الطلب: كل جهاز طلبت منه الزبونة (أو فتحت الطلب عليه برقم الطلب والجوال) إله مفتاح سري.
// بنحفظ بصمة المفتاح بس، عشان لو حدا شاف قاعدة البيانات ما بيقدر يستعمله.
model OrderAccess {
  id        String   @id // بصمة (sha256) المفتاح
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
}

// كل تغيير بحالة الطلب ومتى صار
model OrderStatus {
  id      Int      @id @default(autoincrement())
  orderId Int
  status  String
  at      DateTime @default(now())
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ===== إعدادات المتجر (صف واحد) =====
model Settings {
  id        Int      @id @default(1)
  data      Json     // واتساب، الروابط، مناطق التوصيل، التبديل، الشريط...
  updatedAt DateTime @updatedAt
}

// ===== دخول الأدمن =====
model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    // مشفّرة (bcrypt) — كلمة السر نفسها ما بتنحفظ أبداً
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id // بصمة (hash) لرمز الجلسة، مش الرمز نفسه
  adminId   Int
  expiresAt DateTime
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([adminId])
}

// صور لازم ننتبهلها: انرفعت أو انشالت من منتج. بعد 30 يوم، إذا ما في منتج أو طلب حديث بيستعملها، بتنحذف من التخزين.
// (مش فوراً: عشان لو استرجعتي نسخة احتياطية من قبل، الصور تضل موجودة)
model ImageCheck {
  ref   String   @id // r2:products/abc.webp أو up:abc.webp
  since DateTime @default(now())

  @@index([since])
}
